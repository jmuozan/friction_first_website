% style.sty
% Editorial / brochure style inspired by the reference spreads in ref/
% CircularStd for titles, Helvetica Neue Light for body text.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style}[2026/08/05 editorial brochure style]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{geometry}
\RequirePackage{enumitem}
\RequirePackage{ragged2e}
\RequirePackage{graphicx}
\RequirePackage[absolute,overlay]{textpos}

% ---------- palette (sampled from the reference images) ----------
\definecolor{accent}{HTML}{E84438} % terracotta red-orange accent
\definecolor{ink}{HTML}{161616}    % near-black headlines
\definecolor{body}{HTML}{2E2E2E}   % dark grey body copy
\definecolor{rule}{HTML}{D9D9D9}   % faint grey hairlines

% ---------- fonts ----------
\setmainfont{Helvetica Neue Light}[
  ItalicFont   = {Helvetica Neue Light Italic},
  BoldFont     = {Helvetica Neue Medium},
  BoldItalicFont = {Helvetica Neue Medium Italic}
]

\newfontfamily\titlefont{CircularStd-Medium}[
  Path = fonts/,
  Extension = .ttf,
  UprightFont = *
]

% ---------- page geometry: A5, twoside so spreads mirror ----------
\geometry{
  a5paper,
  twoside,
  inner=15mm,
  outer=12mm,
  top=18mm,
  bottom=20mm
}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6\baselineskip}
\color{body}

% ---------- typographic commands ----------

% Big Circular headline
\newcommand{\headline}[1]{{\titlefont\fontsize{22}{24}\selectfont\color{ink}#1}}

% Small bold eyebrow / pull-quote line above a headline
\newcommand{\eyebrow}[1]{{\bfseries\small\color{ink}#1}\par\vspace{2mm}}

% Section kicker, e.g. running head top-left of a page ("HKU Theater")
\newcommand{\kicker}[1]{{\titlefont\fontsize{11}{13}\selectfont\color{ink}#1}}

% Sub-heading inside body copy ("Wat leer je?")
\newcommand{\subhead}[1]{{\bfseries\small\color{ink}#1}\par\smallskip}

% A contents-style entry: label flush left, page number in accent, flush right
\newcommand{\indexentry}[2]{%
  \noindent{\small\color{body}#1}\hfill{\titlefont\color{accent}#2}\par
  \vspace{3mm}
}

% Thin accent vertical rule placed in the inner-margin gutter, full text-height
\newcommand{\marginrule}{%
  \begin{tikzpicture}[remember picture,overlay]
    \draw[accent,line width=0.6pt]
      ($(current page.north west)+(9mm,-18mm)$) --
      ($(current page.south west)+(9mm,20mm)$);
  \end{tikzpicture}%
}

% Small accent tick mark used as a lone typographic ornament (top of gutter)
\newcommand{\marginticknorth}{%
  \begin{tikzpicture}[remember picture,overlay]
    \draw[accent,line width=1.2pt]
      ($(current page.north west)+(9mm,-14mm)$) --++ (0,4mm);
  \end{tikzpicture}%
}

% Large accent page number in the bottom outer corner
\newcommand{\accentfolio}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south east,color=accent,font=\titlefont\fontsize{20}{20}\selectfont]
      at ($(current page.south east)+(-12mm,10mm)$) {\thepage};
  \end{tikzpicture}%
}

% Vertical rotated credit / footer text along the bottom-left margin
\newcommand{\marginfooter}[1]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south west,rotate=90,font=\tiny\color{body}]
      at ($(current page.south west)+(4mm,20mm)$) {#1};
  \end{tikzpicture}%
}

% Accent-colored contact / footer block (address, phone, links...)
\newcommand{\contactblock}[1]{{\small\color{accent}#1}}

% ---------- index page (large TOC, inspired by ref/index.png) ----------

% Page heading for the index itself
\newcommand{\indexheading}[1]{{\titlefont\fontsize{22}{24}\selectfont\color{ink}#1}\par\vspace{9mm}}

% One large index line: label + accent folio, underscored by a thick accent rule
\newcommand{\bigindexentry}[2]{%
  \noindent{\titlefont\fontsize{14}{16}\selectfont\color{body}\MakeUppercase{#1}}\hfill{\titlefont\fontsize{20}{20}\selectfont\color{accent}#2}\par
  \vspace{-0.5mm}
  {\color{accent}\rule{\linewidth}{1.4pt}}\par
  \vspace{8mm}
}

% ---------- article / section page ----------

% Big headline followed immediately by a full-width rule (ref/starter_page_1.png)
\newcommand{\articletitle}[1]{%
  {\titlefont\fontsize{27}{29}\selectfont\color{ink}#1}\par
  \vspace{3mm}
  {\color{ink}\rule{\linewidth}{0.8pt}}\par
  \vspace{5mm}
}

% Small sidebar metadata block (ref/starter_page_1.png byline block)
\newcommand{\metabox}[1]{{\fontsize{8}{11}\selectfont\color{body}#1}}

% Thin vertical rule drawn between two body columns at a given x-offset
% from the page's left edge (mm), spanning [y0,y1] mm below the top edge.
\newcommand{\columndivider}[3]{%
  \begin{tikzpicture}[remember picture,overlay]
    \draw[accent,line width=0.5pt]
      ($(current page.north west)+(#1,-#2)$) --
      ($(current page.north west)+(#1,-#3)$);
  \end{tikzpicture}%
}

% ---------- cover / poster page (ref/cover.png) ----------

% One of the four top info columns: bold label + value line beneath
\newcommand{\coverfield}[2]{%
  {\small\bfseries\color{ink}#1}\par
  {\small\color{body}#2}%
}

% Duotone-style texture block: a soft blue tint with a few diagonal bands,
% evoking the halftone photo behind the cover's title without embedding a
% real image.
\newcommand{\halftoneblock}[4]{% x0,y0 (mm from page NW), width, height (mm)
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}
      \clip ($(current page.north west)+(#1,-#2)$) rectangle
            ($(current page.north west)+(#1+#3,-#2-#4)$);
      \shade[left color=blue!12,right color=blue!30]
            ($(current page.north west)+(#1,-#2)$) rectangle
            ($(current page.north west)+(#1+#3,-#2-#4)$);
      \foreach \k in {1,...,14}{
        \draw[blue!45!black,opacity=0.18,line width=1.4pt]
          ($(current page.north west)+(#1-10+2*\k,-#2)$) --
          ($(current page.north west)+(#1-10+2*\k+#4,-#2-#4)$);
      }
    \end{scope}
  \end{tikzpicture}%
}

\pagestyle{empty}
\endinput
